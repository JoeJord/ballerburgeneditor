<?xml version="1.0" encoding="UTF-8"?>
<menuconfig>
    <menu id="file">
        <item id="file.new" type="action" shortcut="Ctrl+N"/>
        <item id="file.open" type="action" shortcut="Ctrl+O"/>
        <item id="file.close" type="action" shortcut="Ctrl+W"/>
        <item id="file.recent" type="action"/>
        <item/>
        <item id="file.save" type="action" shortcut="Ctrl+S"/>
        <item id="file.saveas" type="action"/>
        <item/>
        <item id="file.exit" type="action"/>
    </menu>
    <menu id="edit">
        <item id="edit.delete_castle" type="action"/>
        <item id="edit.add_castle" type="action"/>
    </menu>
    <menu id="settings">
        <menu id="settings.lan">
            <item id="lan.de;lan.en" option="language" type="radio"/>
        </menu>
        <menu id="settings.laf" type="laf"/>
    </menu>
    <menu id="help">
        <menu id="help.update">
            <item id="help.update.check" type="action"/>
            <item id="help.update.autocheck" option="autocheckupdate" type="checkbox"/>
        </menu>
        <item/>
        <item id="help.about" type="action"/>
    </menu>
    <toolbar>
        <item id="file.exit"/>
        <item id="file.new"/>
        <item id="file.save"/>
        <item/>
        <item id="edit.delete_castle"/>
        <item id="edit.add_castle"/>
    </toolbar>
    <images path="/hgb/gui/gfx">
        <image id="null" file="null.png"/>
        <image id="nullx" file="nullx.png"/>
        <image id="file.new" file="new.png"/>
        <image id="file.open" file="open.png"/>
        <image id="file.save" file="save.png"/>
        <image id="file.exit" file="exit.png"/>
        <image id="edit.cut" file="cut.png"/>
        <image id="edit.copy" file="copy.png"/>
        <image id="edit.paste" file="paste.png"/>
        <image id="help.about" file="about.png"/>
        <image id="updating" file="updating.gif"/>
    </images>
    <images path="/gfx/tools">
        <image id="edit.delete_castle" file="delete_castle.png"/>
        <image id="edit.add_castle" file="add_castle.png"/>
    </images>
</menuconfig>